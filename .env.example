# Development runs locally with embedded Postgres. Production requires external Postgres.
APP_MODE=development
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Production: 32+ random bytes, injected by Secret Manager.
SESSION_SECRET=
DATABASE_URL=
DATABASE_ADMIN_URL=
# Per-tenant provider configuration must be supplied in Secret Manager; never commit secrets.
# JSON mapping tenant UUID -> provider credentials. See docs/INTEGRATIONS.md.
TENANT_SECRETS_JSON={}
RESEND_API_KEY=
AUTH_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_PLAYBACK_RESTRICTION_ID=
# Private course documents. Cloud Run uses its service account via Application Default Credentials.
GCS_MEDIA_BUCKET=
# Direct video uploads and processing status; keep these server-side.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
